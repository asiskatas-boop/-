rules_version = '2';
// Paste into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // the shared debt tab
    match /kisses/_ledger {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['sent', 'updated'])
                            && request.resource.data.sent is map;
    }

    // messages: anyone with the app can read and send, nobody can edit or delete
    match /kisses/{id} {
      allow read: if true;
      allow create: if id != '_ledger'
        && request.resource.data.type in ['kiss', 'hug', 'papoi', 'draw']
        && request.resource.data.time is int
        && request.resource.data.keys().hasOnly(['type', 'color', 'location', 'mediaUrl', 'from', 'fromName', 'time']);
      allow update, delete: if false;
    }

    // the couch agenda: add, tick/untick, and clear ticked items
    match /together/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['text', 'by', 'done', 'time'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 140
        && request.resource.data.by is string
        && request.resource.data.done == false
        && request.resource.data.time is int;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'doneBy', 'doneAt'])
        && request.resource.data.done is bool;
      allow delete: if resource.data.done == true;
    }
  }
}
